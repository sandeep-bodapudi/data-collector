# Copy this file to ".env" for local settings. On Render, set these under Environment.

# Database. Examples:
#   MySQL (XAMPP):  mysql+pymysql://root:@127.0.0.1/onebridge_scraper
#   PostgreSQL:     postgresql+psycopg://user:pass@host/dbname
# Leave empty to use a SQLite file in instance/data.db
DATABASE_URL=

# Keeps sign-ins valid and encrypts saved AI keys. Set a long random value on servers
# and never change it (changing it makes saved AI keys unreadable).
SECRET_KEY=

# First admin account, created on first start when the database has no users.
APP_USER=admin
APP_PASSWORD=

# Optional but strongly recommended for serious use: official search APIs, far more reliable than the free
# scraping-based fallback (see "Finding websites for places" in README.md for real measured numbers).
# Brave Search API: free tier 2,000 queries/month. https://brave.com/search/api/
BRAVE_API_KEY=
# Google Programmable Search: free tier 100 queries/DAY. Create an engine (set it to "Search the entire web")
# at https://programmablesearchengine.google.com/ for GOOGLE_CSE_CX, then an API key at
# https://developers.google.com/custom-search/v1/introduction for GOOGLE_CSE_KEY. Used automatically as a
# second option, after Brave and before the free engines.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Optional: tune how hard "Places" searches for each place's own website (see README for the measured tradeoff).
# DISCOVER_MAX_PER_RUN=80
# DISCOVER_GAP_SECONDS=5.0
# DISCOVER_RETRY_WAIT=25.0
