# Copy this file to ".env" for local settings. On Render, set these under Environment.

# Database. Examples:
#   MySQL (XAMPP):  mysql+pymysql://root:@127.0.0.1/onebridge_scraper
#   PostgreSQL:     postgresql+psycopg://user:pass@host/dbname
# Leave empty to use a SQLite file in instance/data.db
DATABASE_URL=

# Keeps sign-ins valid and encrypts saved AI keys. Set a long random value on servers
# and never change it (changing it makes saved AI keys unreadable).
SECRET_KEY=

# First admin account, created on first start when the database has no users.
APP_USER=admin
APP_PASSWORD=

# Optional but strongly recommended for serious use: official search APIs, far more reliable than the free
# scraping-based fallback (see "Finding websites for places" in README.md for real measured numbers).
# Brave Search API (free tier 2,000 queries/month, https://brave.com/search/api/) is no longer set here - each
# person adds their own key in Settings -> Search connector, so it isn't shared across the whole team.
# Google Programmable Search: free tier 100 queries/DAY. Create an engine (set it to "Search the entire web")
# at https://programmablesearchengine.google.com/ for GOOGLE_CSE_CX, then an API key at
# https://developers.google.com/custom-search/v1/introduction for GOOGLE_CSE_KEY. Used automatically as a
# second option, after Brave and before the free engines.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Optional: tune how hard "Places" and "Search the web" pace requests to search engines
# (see "Scaling up" in README for the measured tradeoff). DISCOVER_KEYED_GAP_SECONDS only
# applies once a Brave or Google CSE key above is set — searches get much faster then.
# DISCOVER_MAX_PER_RUN=80
# DISCOVER_GAP_SECONDS=5.0
# DISCOVER_RETRY_WAIT=25.0
# DISCOVER_KEYED_GAP_SECONDS=1.1
# How long one free-engine request can take before giving up and trying the next engine (default 4s). A slow or
# half-blocking engine sitting at the full timeout, repeated across every engine a lookup tries, is the main cause
# of a single website lookup taking far longer than expected - see "Why a lookup can feel slow" in README.
# FREE_ENGINE_TIMEOUT_SECONDS=4

# Optional: route outgoing requests through a proxy (your own, e.g. a residential/rotating
# provider you already pay for — this app has no managed proxy pool of its own). Standard
# env vars, honoured automatically with no code changes:
#   HTTP_PROXY / HTTPS_PROXY   used by page fetching (scraper/fetch.py, via the `requests` library)
#   DDGS_PROXY                 used by the free search engines (the `ddgs` library)
# Example: HTTP_PROXY=http://user:pass@proxyhost:8080
# HTTP_PROXY=
# HTTPS_PROXY=
# DDGS_PROXY=
